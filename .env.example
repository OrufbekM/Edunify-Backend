NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:change-me@localhost:5432/edunify
# At least 32 characters each, and different from each other.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-one
FILE_URL_SECRET=change-me-to-a-long-random-string-two
# Absolute path.
STORAGE_DIR=/absolute/path/to/edunify-storage
# AI grading is switched off for now: true turns it back on (it also needs a key below).
AI_GRADING_ENABLED=false
# AI grading. Which AI grades which homework: anthropic, gemini or openai.
# TEXT is typed answers (text, code); IMAGE is pages (draw, math, photo).
# Both default to anthropic. The fallback is tried when the first one fails; empty = none.
AI_PROVIDER_TEXT=anthropic
AI_PROVIDER_IMAGE=anthropic
AI_FALLBACK_PROVIDER=
# A provider without its key is off. With no provider left for a homework type,
# AI grading of that type answers AI_UNAVAILABLE.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Required for every provider named above.
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=
OPENAI_MODEL=

# Only for `npm run seed:admin`, never read by the server. The password needs 12+ characters.
# ADMIN_LOGIN=edunify_admin
# ADMIN_PASSWORD=

# Tests read DATABASE_URL from a git-ignored .env.test. It must point at a database
# whose name ends in _test, for example postgres://postgres:change-me@localhost:5432/edunify_test

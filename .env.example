NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:change-me@localhost:5432/edunify
# At least 32 characters each, and different from each other.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-one
FILE_URL_SECRET=change-me-to-a-long-random-string-two
# Absolute path.
STORAGE_DIR=/absolute/path/to/edunify-storage
# Optional. Without it, AI grading returns AI_UNAVAILABLE.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Tests read DATABASE_URL from a git-ignored .env.test. It must point at a database
# whose name ends in _test, for example postgres://postgres:change-me@localhost:5432/edunify_test
